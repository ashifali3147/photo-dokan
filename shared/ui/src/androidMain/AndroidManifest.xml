<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Choosing photos still works on a device without a camera. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name="com.tlw.photodokan.ui.photo.CameraActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name="com.tlw.photodokan.ui.station.QrScanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Lets the app receiving a shared sheet PDF read it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_dokan_shared_files" />
        </provider>
    </application>
</manifest>
